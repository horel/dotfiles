[user]
	email = cherrystray@gmail.com
	name = Horel
# Please install git-delta first
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
    pager = less -R --mouse --wheel-lines=3
[merge]
    conflictstyle = zdiff3
[diff]
    algorithm = minimal
